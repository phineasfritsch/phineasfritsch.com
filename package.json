{
	"name": "phineasfritsch.com",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node ops/postbuild.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"gate": "node ops/gate.mjs",
		"gate:fast": "node ops/gate.mjs --fast",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"sanity": "node ops/sanity.mjs",
		"prod": "node ops/read-prod.mjs",
		"deploy": "node ops/deploy.mjs"
	},
	"devDependencies": {
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^26.4.0",
		"jsdom": "^30.0.1",
		"mdsvex": "^0.12.7",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.2.2",
		"typescript": "^6.0.2",
		"vite": "^8.0.7",
		"vitest": "^4.1.11",
		"wrangler": "^4.127.1"
	},
	"dependencies": {
		"@threlte/core": "^8.5.9",
		"@threlte/extras": "^9.14.9",
		"@types/three": "^0.184.0",
		"three": "^0.184.0"
	}
}
